# OpenAI-compatible LLM (optional — mock NPC/tutor when unset)
LLM_BASE_URL=
LLM_MODEL=default
LLM_API_KEY=none

# Example remote LLM on LAN (do not commit real secrets):
# LLM_BASE_URL=http://your-llm-host:8888/v1
# LLM_MODEL=qwen3-8b
# LLM_API_KEY=none

# Speech service URLs (orchestrator)
# CPU profile defaults:
ASR_URL=http://asr-cpu:8101
TTS_URL=http://tts-cpu:8102

# Spark / RTX3090 profiles:
# ASR_URL=http://asr:8101
# TTS_URL=http://tts:8102
# ASR_ENGINE=qwen3-asr-0.6b   # or kotoba-whisper-faster on x86

# Optional pronunciation service (CPU pyopenjtalk + librosa.pyin).
# Empty skips the call and the tutor still runs. Pitch advice never changes stars.
# PRON_URL=http://pron:8103
PRON_URL=

# GPU base image (spark aarch64 / rtx3090 x86 — see NGC tags)
GPU_BASE=nvcr.io/nvidia/pytorch:25.01-py3

# Static assets (browser loads backgrounds/sprites directly)
ASSETS_BASE_URL=http://localhost:8080
# Orchestrator reads baked NPC wavs from this directory (audio/{scenario_id}/).
# ASSETS_PATH=/assets

# Web dev: PCM frame console logs are on during `npm run dev`.
# VITE_LOG_PCM_FRAMES=0

# Hands-free end-of-utterance (Silero VAD, MIT). Push-to-talk ignores these.
# python tools/fetch_vad_model.py
# pip install -e "./orchestrator[vad]"
# VAD_ENABLED=1
# VAD_MODEL_PATH=.cache/vad/silero_vad.onnx
# VAD_SILENCE_MS=500
# VAD_CANDIDATE_MS=250
# VAD_REQUIRE_SPEECH=1

# Optional Smart Turn v3 after VAD (BSD-2-Clause). Not in the default image.
# Heuristic silence scoring is used when this is unset. Push-to-talk bypasses both.
# pip install -e "./orchestrator[smart-turn]"
# SMART_TURN_ENABLED=1
# SMART_TURN_MODEL=pipecat-ai/smart-turn-v3

# Profiles:
# docker compose --profile cpu up
# docker compose --env-file .env.spark --profile spark up
# docker compose --env-file .env.rtx3090 --profile rtx3090 up