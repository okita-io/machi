# Copy on the RTX 3090 host: cp .env.rtx3090.example .env
# Full walkthrough: docs/DEPLOY-3090-TAILSCALE.md

# --- LLM on Spark (OpenAI-compatible Qwen3.8-Flash-Next). Use Spark's Tailscale IPv4 — not localhost.
# On the 3090 PC: install Tailscale, then `tailscale status` → spark-4f07 (e.g. 100.69.65.33:8888).
# Docker orchestrator must use the 100.x address (containers may not resolve MagicDNS hostnames).
# curl "$LLM_BASE_URL/models" to confirm LLM_MODEL (expect Qwen3.8-Flash-Next).
LLM_BASE_URL=http://100.69.65.33:8888/v1
LLM_MODEL=Qwen3.8-Flash-Next
LLM_API_KEY=none

# --- Speech on this box (3090 profile)
# These are Docker DNS names. Compose substitutes the shell over this file, so
# do not export TTS_URL=http://127.0.0.1:8102 before `docker compose up` —
# inside the orchestrator container that address is not the tts service.
# Host-side scripts (scripts/e2e_live_speech.py) should use 127.0.0.1:8101/8102.
ASR_URL=http://asr:8101
TTS_URL=http://tts:8102
PRON_URL=http://pron:8103
ASR_ENGINE=kotoba-whisper-faster
# ASR_ENGINE=qwen3-asr-0.6b
GPU_MEM_FRACTION=0.40
SPEECH_PROFILE=rtx3090
GPU_BASE=nvcr.io/nvidia/pytorch:25.01-py3

# Browser loads art through the web container (same origin for Tailscale clients).
ASSETS_BASE_URL=/assets

# Orchestrator reads baked WAVs from the mounted assets tree.
ASSETS_PATH=/assets

# --- Bring up (on the 3090, after HTTPS cert; see script below):
#   ./scripts/make_lan_https.sh --tailscale $(tailscale ip -4)
#   docker compose --env-file .env --profile rtx3090 --profile https up --build
#
# Mac mini (Tailscale client, mic): https://<3090-tailscale-ip>:5174
# Laptop on LAN (optional HTTP demo): http://<3090-lan-ip>:5173